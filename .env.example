# 로그인 세션 서명. 배포 전에 바꾸세요.
CP_SESSION_SECRET=change-this-secret

# 담당자 메일. 둘 다 있어야 발송을 시도합니다.
CP_MAIL_TO=
CP_MAIL_FROM=

# SMTP 또는 Resend 중 하나를 채우면 입력완료 시 메일이 나갑니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# HTTPS에서만 세션 쿠키를 Secure로 둘 때 true
CP_COOKIE_SECURE=false
